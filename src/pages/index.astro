---
import "../styles/styles.css";

// A scraper reads the head off a copy of this page it fetched, and resolves
// nothing against where it found it. So the card is an absolute URL, built from
// the two things that already know the deployed address: `site` and `base` in
// astro.config.mjs. Hard-coding it here is how it goes stale.
const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/{2,}/g, "/");
const card = new URL(asset("card.png"), Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Declared, and absolute under the base: undeclared, a browser asks the
         domain root for /favicon.ico, which this site does not own. -->
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <title>Context Window — a one-button game about spending your budget</title>
    <meta
      name="description"
      content="A tiny browser game. Your token budget is the clock: it drains as you run, tokens on the track top it back up, and every token you take makes the game faster."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- a real frame of the
      game, taken by `node scripts/shot.ts --card`, so it cannot drift from what
      the game actually looks like. No og:title/og:description: scrapers fall
      back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <!--
      Terminal chrome, and the page's only prose. The game's name is a name, not
      an instruction. The canvas names the keys it answers to while it idles —
      keycap glyphs, not a sentence — and says nothing about what they do. See
      plan/03-feel-and-teaching.md.
    -->
    <header class="chrome">
      <h1>Context Window</h1>
      <nav aria-label="Primary">
        <a href="./" aria-current="page">~/context-window</a>
      </nav>
      <button id="audio" type="button" aria-pressed="true">audio on</button>
    </header>
    <main>
      <!-- The text inside a canvas is its fallback: shown, and read out, only
           where the canvas itself cannot be. -->
      <canvas id="game"
        >Context Window is a one-button endless runner, drawn on a canvas this
        browser cannot render.</canvas
      >
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
