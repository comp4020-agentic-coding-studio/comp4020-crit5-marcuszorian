---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>COMP4020 prototype</title>
    <meta
      name="description"
      content="Replace this with one sentence saying what this page is. A search result and a link preview both show it."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <!--
        The game's name is the only prose on the page, and the brief allows it.
        No instructions anywhere: the caret and the confirming hop teach the
        one input. See plan/03-feel-and-teaching.md.
      -->
      <h1>Context Window</h1>
      <canvas id="game" width="1000" height="500"></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
