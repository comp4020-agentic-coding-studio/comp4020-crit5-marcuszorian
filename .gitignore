node_modules/
dist/
*.log

# Build output of looking at the game, not source. `pnpm shots` rewrites all of
# it on every run, so committing it means a diff of seven binary PNGs on every
# balance pass and a merge conflict nobody can read. Regenerate with
# `pnpm shots` and open the files; that is what they are for.
#
# `public/card.png` is deliberately NOT here: it is the link-preview image the
# deployed page points at, so it has to ship. `pnpm shots --card` promotes the
# card frame into it, and that copy is a source asset.
.shots/

# Test output, same reasoning.
coverage/
test-results/
*.tsbuildinfo

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
.astro/
